# Secrets — never commit
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.envrc

# Runtime outputs (regenerated when you run the pipeline)
step_pipeline/images/
step_pipeline/nougat_output/
step_pipeline/vlm_output/
step_pipeline/video_cache/
step_pipeline/results/
uploads/
uploads_video/
*.log

# Local transcript media/caption downloads
data/transcripts/audio*/
data/transcripts/captions/

# Local task dependencies used for reproducible report generation
.codex_tmp/

# Evaluation reports are versioned under reports/ (figures, tables, JSON/CSV/XLSX).
# Regenerate with tools/eval/* and tools/viz/*; commit updated artifacts when results change.

# Dataset PDFs are not shipped in a minimal zip; add your own under Surface_Integration/
Surface_Integration/*.pdf
*.pdf

# Do not vendor Nougat / Hugging Face cache in the repo (use local HF cache)
nougat/

# IDE
.idea/
.vscode/
*.swp

# Node (local viz/export helpers)
node_modules/
